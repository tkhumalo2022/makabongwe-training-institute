SUPABASE_URL=
# Preferred server key (sb_secret_...). Never expose through NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy fallback during migration.
SUPABASE_SERVICE_ROLE_KEY=
# Public Supabase key used only for Auth API calls. Prefer sb_publishable_...
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated staff emails allowed to access /admin.
MAKABONGWE_ADMIN_EMAILS=
# Cloudflare Turnstile. Site key is public; secret must stay server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Local development only. Never enable this in production.
TURNSTILE_DEV_BYPASS=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ENQUIRY_IP_HASH_SALT=
ENQUIRY_RATE_LIMIT_MAX=
ENQUIRY_RATE_LIMIT_WINDOW_SECONDS=
# Payment provider setup
# Supported values: payfast, yoco, stripe, manual
PAYMENT_PROVIDER=payfast
PAYMENT_MERCHANT_ID=
PAYMENT_MERCHANT_KEY=
PAYMENT_PASSPHRASE=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_RETURN_URL=
PAYMENT_CANCEL_URL=
PAYMENT_NOTIFY_URL=
PAYMENT_SANDBOX=true

# Paystack test-mode payment setup
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_SITE_URL=https://www.makabongwe.network
